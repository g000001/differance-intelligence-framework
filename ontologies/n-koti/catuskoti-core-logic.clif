(cl-text Catuskoti_Core_Logic

(cl-comment "============================================================")
(cl-comment " 四句分別 (Catuṣkoṭi) : 構文的定義 ")
(cl-comment " 目的：エルブラン空間における命題Pの全形式の特定と除去 ")
(cl-comment "============================================================")

;; 1. 基本演算と型の定義
(function Not (object) object)
(function And (object object) object)
(function Or (object object) object)
(predicate IsProposition (object))

;; 2. 四句分別の各形式の定義
(function Form1 (object) object) ;; 是 (Affirmation/True): P
(function Form2 (object) object) ;; 非 (Negation/False): ¬P
(function Form3 (object) object) ;; 亦 (Both/Inconsistent): P ∧ ¬P
(function Form4 (object) object) ;; 非非 (Neither/Incoherent): ¬(P ∨ ¬P)

(forall (?P)
    (if (IsProposition ?P)
        (and 
            (= (Form1 ?P) ?P)
            (= (Form2 ?P) (Not ?P))
            (= (Form3 ?P) (And ?P (Not ?P)))
            (= (Form4 ?P) (Not (Or ?P (Not ?P)))))))

;; 3. 四句の集合的定義（除去プロトコル用）
(function CatuskotiSet (object) object)

(forall (?P)
    (if (IsProposition ?P)
        (= (CatuskotiSet ?P)
           (setof (Form1 ?P) (Form2 ?P) (Form3 ?P) (Form4 ?P)))))

)
