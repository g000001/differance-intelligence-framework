    ;; Functions
    (function ResultOf (object object) object)
    (function delay_n (object Nat) object)
    (function log2 (Nat) Nat)
    
    ;; Predicate for exclusivity
    (forall (?x) (=> (ClosedSelfReference ?x) (not (OpenSelfReference ?x))))
    (forall (?x) (=> (OpenSelfReference ?x) (not (ClosedSelfReference ?x))))
)

