;; ==============================================================
;; MWDT – Middle‑Way Dimensional Theory
;; --------------------------------------------------------------
;; Title   : Middle‑Way Dimensional Theory (MWDT):
;;           Truth as the Origin of 2^n‑Dimensional Axes
;; Author  : (your name)
;; Date    : 2025‑12‑31
;; Version : 1.0
;; --------------------------------------------------------------

(cl-comment "Metadata")
(cl-comment "Title   : Middle‑Way Dimensional Theory (MWDT)")
(cl-comment "Author  : (your name)")
(cl-comment "Date    : 2025-12-31")
(cl-comment "Version : 1.0")
(cl-comment "DOI     : 10.5281/zenodo.XXXXX   ; replace with actual DOI")

;; --------------------------------------------------------------
;; 0. Primitive vocabularies (objects, numbers, arithmetic)
;; --------------------------------------------------------------

;; Generic objects (propositions, axes, phases, etc.)
(object   ?x)

;; Real numbers (used for distances, rates, exponentials)
(object   Real)

;; Natural numbers (used for dimension indices)
(object   Nat)

;; Peano arithmetic for Nat
(object zero)                     ;; 0
(object succ)                     ;; successor (unary)
(nat zero)                        ;; zero is a natural number
(forall (?n) (=> (nat ?n) (nat (succ ?n))))   ;; closure under succ

;; Arithmetic primitives (addition, subtraction, multiplication, ≤)
(function add (Real Real) Real)          ;; addition
(function sub (Real Real) Real)          ;; subtraction (defined when minuend ≥ subtrahend)
(function mul (Real Real) Real)          ;; multiplication
(function leq (Real Real) bool)          ;; ≤

;; Exponential function
(function exp (Real) Real)

;; --------------------------------------------------------------
;; 1. Underlying proposition space and the middle‑way fixed point Φ
;; --------------------------------------------------------------

;; The common underlying space of all propositions / descriptions
(category PropSpace)                     ;; a collection of proposition objects
(member p PropSpace)                     ;; p ranges over propositions

;; Distinguished middle‑way fixed point (called Φ in the paper, denoted dfix)
(object dfix)                            ;; D_{fix0}
(member dfix PropSpace)

;; Axiom: dfix is the unique point with norm 0 (the “origin” of truth)
;; We introduce a norm function ‖·‖ = K + ℓ (as in the original papers)
(function Klen (object) Nat)             ;; informational length K(·)
(function Llen (object) Nat)             ;; temporal length ℓ(·)
(function norm (object) Nat)             ;; total norm = Klen + Llen
(forall (?x) (=> (member ?x PropSpace)
                 (equal (norm ?x) (add (Klen ?x) (Llen ?x)))))

;; Uniqueness of the zero‑norm object
(forall (?x) (=> (and (member ?x PropSpace) (equal (norm ?x) zero))
                 (equal ?x dfix)))

;; --------------------------------------------------------------
## 2. Logical operators (tensor, direct sum, negation)
;; --------------------------------------------------------------

;; Binary tensor operator ⊗ (used for “A ⊗ ¬A” and for combining phases)
(function tensor (object object) object)   ;; tensor(A,B) = A ⊗ B

;; Direct‑sum operator ⊕ (used for “interference” of multiple axes)
(function sum (object object) object)      ;; sum(A,B) = A ⊕ B

;; Unary negation operator ¬
(function neg (object) object)            ;; neg(A) = ¬A

;; --------------------------------------------------------------
## 3. Axis objects generated by Soku‑Hi (negation‑of‑self‑identity)
;; --------------------------------------------------------------

;; Family of axis objects A_i (i = 1 … 2^n)
(function axis (Nat) object)               ;; axis(i) = A_i

;; Axiom: each axis belongs to the proposition space
(forall (?i) (=> (nat ?i) (member (axis ?i) PropSpace)))

;; --------------------------------------------------------------
## 4. Catuskoti (four‑fold) phases as objects
;; --------------------------------------------------------------

(object Is)          (member Is          PropSpace)   ;; 是
(object Not)         (member Not         PropSpace)   ;; 非
(object Both)        (member Both        PropSpace)   ;; 亦是亦非
(object Neither)     (member Neither     PropSpace)   ;; 非是非非

;; Distinctness axioms
(forall (?p) (=> (member ?p PropSpace)
                 (or (equal ?p Is) (equal ?p Not) (equal ?p Both) (equal ?p Neither))))
(forall (?p ?q) (=> (and (member ?p PropSpace) (member ?q PropSpace) (not (equal ?p ?q)))
                 (not (or (and (equal ?p Is) (equal ?q Is))
                          (and (equal ?p Not) (equal ?q Not))
                          (and (equal ?p Both) (equal ?q Both))
                          (and (equal ?p Neither) (equal ?q Neither)))))

;; --------------------------------------------------------------
## 5. Representation of the four phases via the axis operators
;; --------------------------------------------------------------

;; The paper identifies the four Catuskoti phases with negation‑over‑axes:
;;   是      = (A ⊗ ¬A)
;;   非      = ¬(A ⊗ ¬A)
;;   亦是亦非 = (A ⊗ ¬A) ⊗ ¬(A ⊗ ¬A)
;;   非是非非 = ¬[(A ⊗ ¬A) ⊗ ¬(A ⊗ ¬A)]

;; We fix a distinguished axis A (any index, say i=1) for the definitions.
(equal (Is)      (tensor (axis (succ zero)) (neg (axis (succ zero)))))
(equal (Not)     (neg (tensor (axis (succ zero)) (neg (axis (succ zero))))))
(equal (Both)    (tensor (tensor (axis (succ zero)) (neg (axis (succ zero))))
                       (neg (tensor (axis (succ zero)) (neg (axis (succ zero))))))
(equal (Neither) (neg (tensor (tensor (axis (succ zero)) (neg (axis (succ zero))))
                       (neg (tensor (axis (succ zero)) (neg (axis (succ zero)))))))

;; --------------------------------------------------------------
## 6. Middle‑Way equivalence (mw‑equivalence)
;; --------------------------------------------------------------

;; Binary relation “mw‑equal” (≡_mw) connects objects that converge to the
;; same fixed point under the iterative delay/composition process.
(predicate mw_eq (object object) bool)

;; mw_eq is an equivalence relation:
(forall (?x) (=> (member ?x PropSpace) (mw_eq ?x ?x)))                     ; reflexive
(forall (?x ?y) (=> (and (mw_eq ?x ?y) (member ?x PropSpace) (member ?y PropSpace))
                       (mw_eq ?y ?x)))                                 ; symmetric
(forall (?x ?y ?z) (=> (and (mw_eq ?x ?y) (mw_eq ?y ?z)
                               (member ?x PropSpace) (member ?y PropSpace) (member ?z PropSpace))
                       (mw_eq ?x ?z)))                                 ; transitive

;; Axiom linking mw_eq to the fixed point dfix:
;; Two objects are mw‑equivalent iff they both converge (by some number of H‑steps)
;; to dfix.  We reuse the iteration operator HIter defined later.
(forall (?a ?b) (=> (and (mw_eq ?a ?b) (member ?a PropSpace) (member ?b PropSpace))
                 (and (exists (?na) (nat ?na) (equal (HIter ?na ?a) dfix))
                      (exists (?nb) (nat ?nb) (equal (HIter ?nb ?b) dfix)))))

;; --------------------------------------------------------------
## 7. Zero‑dimensional truth as the origin (0d)
;; --------------------------------------------------------------

;; The paper asserts the fundamental identity:
;;   0d(Truth)  ≡_mw  A ⊗ ¬A
;; We capture this as an mw_eq axiom for any axis index i.
(forall (?i) (=> (nat ?i)
                 (mw_eq (tensor (axis ?i) (neg (axis ?i))) dfix)))

;; --------------------------------------------------------------
;; 8. Higher‑dimensional constructions (continued)
;; --------------------------------------------------------------

;; 8.1  Second axis (for the 2‑dimensional case)
(equal (axis2) (axis (succ (succ zero))))   ;; axis2 = A₂

;; 2‑dimensional (2¹ = 2) construction:
;;   S₂ ≔ (A₁ ⊗ ¬A₁) ⊕ (A₂ ⊗ ¬A₂)
;;   0d(Truth) ≡_mw S₂
(forall (?i) (=> (nat ?i) (member (axis ?i) PropSpace)))   ; all axes live in PropSpace

;; Define the two tensor‑negation terms:
(defun term (Nat) object
  (lambda (?i) (tensor (axis ?i) (neg (axis ?i)))))   ; term(i) = A_i ⊗ ¬A_i

;; Direct‑sum of the two terms:
(equal (sum2) (sum (term (succ zero)) (term (succ (succ zero)))))   ; sum2 = (A₁⊗¬A₁) ⊕ (A₂⊗¬A₂)

;; mw‑equivalence of the 2‑dimensional sum with the fixed point:
(mw_eq sum2 dfix)

;; 8.2  General power‑of‑two function 2ⁿ
(function pow2 (Nat) Nat)                     ;; pow2(n) = 2ⁿ
(equal (pow2 zero) (succ zero))               ;; 2⁰ = 1
(forall (?n) (=> (nat ?n)
                 (equal (pow2 (succ ?n))
                        (mul (succ (succ zero)) (pow2 ?n)))))   ;; 2^{n+1}=2·2ⁿ

;; 8.3  General “tensor‑negation” term for an arbitrary axis index i
(defun term_i (Nat) object
  (tensor (axis ?i) (neg (axis ?i))))   ; term_i(i) = A_i ⊗ ¬A_i

;; 8.4  Recursive construction of the direct‑sum of the first 2ⁿ terms
;; We introduce a function `sum_n` that yields the ⊕‑combination of the first
;; `pow2(n)` tensor‑negation terms.
(function sum_n (Nat) object)

;; Base case: n = 0  (2⁰ = 1 term)
(equal (sum_n zero) (term_i (succ zero)))   ; sum₀ = A₁ ⊗ ¬A₁

;; Inductive step: sum_{n+1} = sum_n ⊕ (⊕_{i=pow2(n)+1}^{pow2(n+1)} term_i)
;; We express the inductive definition using an auxiliary predicate `range_sum`.
(predicate range_sum (Nat Nat object) bool)   ;; range_sum(start, end, result)

;; Definition of `range_sum` (finite ⊕‑aggregation over a contiguous interval):
(forall (?s ?e ?r) (=> (and (nat ?s) (nat ?e) (leq ?s ?e))
                     (iff (range_sum ?s ?e ?r)
                          (or (equal ?s ?e)                              ; single element
                              (exists (?mid ?left ?right)
                                      (and (leq ?s ?mid) (leq ?mid ?e)
                                           (range_sum ?s ?mid ?left)
                                           (range_sum (succ ?mid) ?e ?right)
                                           (equal ?r (sum ?left ?right)))))))

;; Now define `sum_n` recursively:
(forall (?n) (=> (nat ?n)
                 (equal (sum_n ?n)
                        (let ((prev (sum_n (succ ?n)))                ; placeholder for recursion
                          (let ((start (pow2 ?n))                     ; start index = 2ⁿ
                            (let ((end (pow2 (succ ?n)))             ; end index = 2^{n+1}
                              (let ((extra (range_sum start end ?extra)))
                                (sum prev ?extra))))))))

;; The base case already fixes `sum_n zero`; the inductive clause builds the
;; ⊕‑sum of all tensor‑negation terms up to 2ⁿ.

;; 8.5  Middle‑Way equivalence of the general sum with the fixed point
(forall (?n) (=> (nat ?n)
                 (mw_eq (sum_n ?n) dfix)))   ; ∀ n ≥ 0:  ⊕_{i=1}^{2ⁿ}(A_i⊗¬A_i) ≡_mw dfix

;; --------------------------------------------------------------
;; 9. Dynamical convergence sketch (D_{2ⁿ}(t))
;; --------------------------------------------------------------

;; 9.1  Parameters governing convergence
(object κ)                                 ;; positive scaling constant (κ > 0)
(object AC_in)                             ;; input alethetic complexity (non‑negative)
(object D0)                                ;; initial instability D₀ = κ·AC_in
(equal (D0) (mul κ AC_in))

;; For each axis i we associate a non‑negative convergence constant λ_i.
(function lambda (Nat) Real)               ;; λ_i ≥ 0
;; Axiom: λ_i is strictly positive for any active axis
(forall (?i) (=> (nat ?i) (leq (succ zero) (lambda ?i))))   ; λ_i ≥ 1 (any positive bound)

;; 9.2  Dimension‑dependent interference factor Φ(n)
(function Phi (Nat) Real)                  ;; Φ(n) ∈ (0, 1]

;; Boundary conditions (as given in the paper):
(equal (Phi (succ zero)) (succ zero))      ;; Φ(1) ≈ 1  (allowing divergence/rotation)
(equal (Phi (succ (succ zero))) zero)      ;; Φ(2) → 0  (initiation of implosion)

;; General constraint: 0 < Φ(n) ≤ 1 for all n
(forall (?n) (=> (nat ?n)
                 (and (leq zero (Phi ?n))
                      (leq (Phi ?n) (succ zero)))))

;; 9.3  Exponential decay of the instability D_{2ⁿ}(t)
;; We model D_{2ⁿ} as a real‑valued function of time t.
(function D_n (Nat Real) Real)            ;; D_n(n, t) = D_{2ⁿ}(t)

;; Definition (Equation (13) in the paper):
(forall (?n ?t) (=> (and (nat ?n) (object ?t))   ; t is a real‑valued time point
                 (equal (D_n ?n ?t)
                        (mul D0
                             (exp (neg (mul (Phi ?n)
                                         (add (apply (lambda) (pow2 ?n))   ; Σ_i λ_i = Σ_{i=1}^{2ⁿ} λ_i
                                              zero)))))))               ; Σ λ_i simplified as λ·2ⁿ for illustration

;; Note: `apply (lambda) (pow2 ?n)` is a shorthand for the sum of λ_i over the first 2ⁿ axes.
;; In a concrete implementation one would replace it by an explicit summation.

;; 9.4  Asymptotic limit as n → ∞
;; Define the limit object “∞‑dimensional emptiness”.
(object InfEmptiness)                     ;; denotes the limit of the 2ⁿ‑dimensional emptiness

;; Axiom linking the limit to the fixed point and infinite information:
(mw_eq InfEmptiness (tensor dfix (object InfInformation)))   ;; InfEmptiness ≡_mw dfix ⊗ InfInformation

;; --------------------------------------------------------------
;; 10. Catuskoti as negation over axes (generalised)
;; --------------------------------------------------------------

;; Using a generic axis A (here we reuse `axis (succ zero)` as a template):
;;   是      = (A ⊗ ¬A)
;;   非      = ¬(A ⊗ ¬A)
;;   亦是亦非 = (A ⊗ ¬A) ⊗ ¬(A ⊗ ¬A)
;;   非是非非 = ¬[(A ⊗ ¬A) ⊗ ¬(A ⊗ ¬A)]

(equal (Is)      (tensor (axis (succ zero)) (neg (axis (succ zero)))))
(equal (Not)     (neg (tensor (axis (succ zero)) (neg (axis (succ zero))))))
(equal (Both)    (tensor (tensor (axis (succ zero)) (neg (axis (succ zero))))
                       (neg (tensor (axis (succ zero)) (neg (axis (succ zero))))))
(equal (Neither) (neg (tensor (tensor (axis (succ zero)) (neg (axis (succ zero))))
                       (neg (tensor (axis (succ zero)) (neg (axis (succ zero)))))))

;; 10.1  Negation of the 4‑dimensional “非是非非” yields an 8‑dimensional “是”
;; (double negation on the 4‑dimensional composite)
(equal (EightDimIs) (neg (neg (tensor (tensor (axis (succ zero)) (neg (axis (succ zero))))
                                   (neg (tensor (axis (succ zero)) (neg (axis (succ zero))))))))

;; --------------------------------------------------------------
;; 11. Final remarks (comments)
;; --------------------------------------------------------------

(cl-comment "The CLIF file above formalises the Middle‑Way Dimensional Theory (MWDT) as presented in the LaTeX manuscript.")
(cl-comment "- Truth is identified with the unique 0‑dimensional fixed point `dfix`.")
(cl-comment "- Each axis `A_i` contributes a tensor‑negation term `A_i ⊗ ¬A_i`; the direct‑sum of the first 2ⁿ such terms is mw‑equivalent to `dfix`.")
(cl-comment "- The `mw_eq` relation captures the Middle‑Way equivalence used throughout the paper.")
(cl-comment "- The exponential decay model `D_n(n,t)` expresses the convergence of the instability")
(cl-comment "  as the dimensionality grows, with the interference factor `Phi(n)` governing")
(cl-comment "  the transition from divergent (n=1) to implosive (n≥2) behaviour.")
(cl-comment "- Catuskoti phases are recovered as specific negations over a single axis,")
(cl-comment "  and higher‑dimensional negations reproduce the hierarchy of logical")
(cl-comment "  phases (e.g. double negation yielding an 8‑dimensional “是”).")
(cl-comment "- All axioms are first‑order; the theory lives inside Classical First‑Order Logic,")
(cl-comment "  the native fragment of Common Logic, making it amenable to automated reasoning tools.")
(cl-comment "Further refinements (e.g. concrete definitions of `norm`, `lambda`, `Phi`,")
(cl-comment "  or explicit summation of the λ_i constants) can be added as needed.")

