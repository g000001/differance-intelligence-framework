(cl:in-package cl-user)
(defpackage #:project-euler-0168 (:use cl iterate alexandria) (:export #:solve))
(in-package #:project-euler-0168)

(defmacro optimized-code-p (boole)
  (typecase boole
    (null nil)
    (T `(declaim (optimize (speed 3) (safety 0) (debug 0) #+lispworks (hcl:fixnum-safety 0))))))

(optimized-code-p nil)


(defconstant $limit-length 100)
(defconstant $modulo-value #.(expt 10 5))

(defun solve ()
  (let ((total-sum 0))
    (iterate (for length-l from 2 to $limit-length)
      (let ((num-base (- (expt 10 length-l) 1))
            (min-n (expt 10 (- length-l 1)))
            (sum-for-length 0))
        (iterate (for multiplier-k from 1 to 9)
          (let ((den (- (* 10 multiplier-k) 1)))
            (iterate (for digit-d from 1 to 9)
              (multiple-value-bind (quotient remainder)
                  (truncate (* digit-d num-base) den)
                ;; 割り切れる かつ L桁の数である（リーディングゼロがない）ことを確認
                (when (and (= remainder 0) (>= quotient min-n))
                  (incf sum-for-length quotient)
                  (incf total-sum quotient))))))
        ;; 最外周で桁ごとの進行状況と中間合計を観測
        (format t "Length ~A: Found sum for this layer = ~A~%" length-l sum-for-length)))
    
    (let ((final-result (mod total-sum $modulo-value)))
      (format t "--------------------------------------------------~%")
      (format t "Total Sum (all digits): ~A~%" total-sum)
      (format t "Last 5 digits: ~A~%" final-result)
      final-result)))

