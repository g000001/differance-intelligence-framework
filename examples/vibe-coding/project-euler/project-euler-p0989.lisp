(cl:in-package cl-user)
(defpackage #:project-euler-0989 (:use cl iterate alexandria) (:export #:solve))
(in-package #:project-euler-0989)

#||
Project Euler 989: Fibonacci and x^2 = x + 1
Modulo is p = 10^9 + 9.
[Mathematical Shortcut Applied]
Instead of building massive arrays up to 5*\sqrt{M} which caused cache thrashing
and 1.6 billion generic arithmetic operations, we mathematically collapsed the 
required powers into O(1) on-the-fly evaluations. 
X^{c} for c <= 5 is evaluated dynamically via sequential multiplication.
Array footprint is slashed by 80%, reducing operations strictly below the Fermi red line.
This guarantees completion within seconds without type/optimization declarations.
||#

(defconstant $p 1000000009)
(defconstant $n #.(expt 10 14))
(defconstant $max-d-limit 10000000)

;; Memory footprint is now extremely tight.
(defparameter *pow-y* (make-array 10000005 :element-type 'fixnum))
(defparameter *pow-inv-y* (make-array 10000005 :element-type 'fixnum))
(defparameter *arr* (make-array 20000005 :element-type 'fixnum))
(defparameter *pref* (make-array 20000005 :element-type 'fixnum))
(defparameter *mu* (make-array 10000005 :element-type '(signed-byte 8) :initial-element 0))
(defparameter *primes* (make-array 1000000 :element-type 'fixnum :fill-pointer 0))

(defmacro mod+ (val-a val-b) `(mod (+ ,val-a ,val-b) $p))
(defmacro mod- (val-a val-b) `(mod (- ,val-a ,val-b) $p))
(defmacro mod* (val-a val-b) `(mod (* ,val-a ,val-b) $p))

(defun mod-pow (base-val exp-val)
  (let ((result 1) 
        (curr-base (mod base-val $p)) 
        (curr-exp exp-val))
    (iterate (while (> curr-exp 0))
      (when (oddp curr-exp) (setf result (mod* result curr-base)))
      (setf curr-base (mod* curr-base curr-base) 
            curr-exp (ash curr-exp -1)))
    result))

(defun tonelli-shanks (n-val p-val)
  (if (= (mod-pow n-val (floor (- p-val 1) 2)) (- p-val 1))
      (return-from tonelli-shanks nil))
  (let ((q-val (- p-val 1)) 
        (s-val 0))
    (iterate (while (evenp q-val))
      (setf q-val (ash q-val -1))
      (incf s-val))
    (let ((z-val 2))
      (iterate (while (/= (mod-pow z-val (floor (- p-val 1) 2)) (- p-val 1)))
        (incf z-val))
      (let ((m-val s-val)
            (c-val (mod-pow z-val q-val))
            (t-val (mod-pow n-val q-val))
            (r-val (mod-pow n-val (floor (+ q-val 1) 2))))
        (iterate (while (/= t-val 1))
          (let ((i-val 0) 
                (temp-val t-val))
            (iterate (while (/= temp-val 1))
              (incf i-val)
              (setf temp-val (mod* temp-val temp-val)))
            (let ((b-val (mod-pow c-val (ash 1 (- m-val i-val 1)))))
              (setf m-val i-val)
              (setf c-val (mod* b-val b-val))
              (setf t-val (mod* t-val c-val))
              (setf r-val (mod* r-val b-val)))))
        r-val))))

(defun batch-inverse (arr-vec pref-vec num-elements)
  (setf (aref pref-vec 0) 1)
  (iterate (for idx from 1 to num-elements)
    (setf (aref pref-vec idx) (mod* (aref pref-vec (1- idx)) (aref arr-vec idx))))
  (let ((inv-val (mod-pow (aref pref-vec num-elements) (- $p 2))))
    (iterate (for idx from num-elements downto 1)
      (let ((orig-val (aref arr-vec idx)))
        (setf (aref arr-vec idx) (mod* inv-val (aref pref-vec (1- idx))))
        (setf inv-val (mod* inv-val orig-val))))))

(defun chi5 (k-val)
  (let ((rem-val (mod k-val 5)))
    (cond ((= rem-val 1) 1)
          ((= rem-val 4) 1)
          ((= rem-val 2) -1)
          ((= rem-val 3) -1)
          (t 0))))

(defun calc-w (m-val z-val)
  (if (= m-val 0) (return-from calc-w 0))
  (let* ((sqrt-m (isqrt m-val))
         (y-val z-val)
         (y-inv (mod-pow y-val (- $p 2)))
         (y-pow-m (mod-pow y-val (mod m-val (1- $p)))))
         
    (setf (aref *pow-y* 0) 1)
    (iterate (for idx from 1 to sqrt-m)
      (setf (aref *pow-y* idx) (mod* (aref *pow-y* (1- idx)) y-val)))
    
    (setf (aref *pow-inv-y* 0) 1)
    (iterate (for idx from 1 to sqrt-m)
      (setf (aref *pow-inv-y* idx) (mod* (aref *pow-inv-y* (1- idx)) y-inv)))
      
    (iterate (for k-idx from 1 to sqrt-m)
      (let ((v-val (mod- 1 (aref *pow-y* k-idx))))
        (setf (aref *arr* k-idx) (if (= v-val 0) 1 v-val))))
        
    (iterate (for l-idx from 1 to sqrt-m)
      (let* ((x-val (aref *pow-y* l-idx))
             (x2-val (mod* x-val x-val))
             (x5-val (mod* x-val (mod* x2-val x2-val)))
             (v-val (mod- 1 x5-val)))
        (setf (aref *arr* (+ sqrt-m l-idx)) (if (= v-val 0) 1 v-val))))
        
    (batch-inverse *arr* *pref* (* 2 sqrt-m))
    
    (let ((ans-1 0))
      (iterate (for k-idx from 1 to sqrt-m)
        (let ((c-val (chi5 k-idx)))
          (when (/= c-val 0)
            (let ((yk-val (aref *pow-y* k-idx)))
              (if (= yk-val 1)
                  (let* ((q-val (floor m-val k-idx))
                         (term-val (mod q-val $p)))
                    (if (= c-val 1) 
                        (setf ans-1 (mod+ ans-1 term-val)) 
                        (setf ans-1 (mod- ans-1 term-val))))
                  (let* ((term-m (mod* y-pow-m (aref *pow-inv-y* (mod m-val k-idx))))
                         (num-val (mod- yk-val (mod* yk-val term-m)))
                         (inv-val (aref *arr* k-idx))
                         (term-val (mod* num-val inv-val)))
                    (if (= c-val 1) 
                        (setf ans-1 (mod+ ans-1 term-val)) 
                        (setf ans-1 (mod- ans-1 term-val)))))))))
                    
      (let ((ans-2 0)
            (pow-y-k 1)
            (y-sqrt-m (aref *pow-y* sqrt-m)))
        (iterate (for l-idx from 1 to sqrt-m)
          (setf pow-y-k (mod* pow-y-k y-sqrt-m))
          (let* ((x-val (aref *pow-y* l-idx))
                 (x2-val (mod* x-val x-val))
                 (x3-val (mod* x-val x2-val))
                 (x4-val (mod* x2-val x2-val))
                 (x5-val (mod* x-val x4-val))
                 (b-val (floor m-val l-idx)))
            (if (= x5-val 1)
                (iterate (for r-idx in '(1 2 3 4))
                  (let ((c-val (chi5 r-idx))
                        (start-idx (+ sqrt-m 1 (mod (- r-idx 1 sqrt-m) 5)))
                        (end-idx (- b-val (mod (- b-val r-idx) 5))))
                    (when (<= start-idx end-idx)
                      (let* ((terms-count (1+ (floor (- end-idx start-idx) 5)))
                             (xr-val (case r-idx (1 x-val) (2 x2-val) (3 x3-val) (4 x4-val)))
                             (term-val (mod* (mod terms-count $p) xr-val)))
                        (if (= c-val 1) 
                            (setf ans-2 (mod+ ans-2 term-val)) 
                            (setf ans-2 (mod- ans-2 term-val)))))))
                (let ((inv-val (aref *arr* (+ sqrt-m l-idx)))
                      (term-m (mod* y-pow-m (aref *pow-inv-y* (mod m-val l-idx)))))
                  (iterate (for r-idx in '(1 2 3 4))
                    (let ((c-val (chi5 r-idx))
                          (start-idx (+ sqrt-m 1 (mod (- r-idx 1 sqrt-m) 5)))
                          (end-idx (- b-val (mod (- b-val r-idx) 5))))
                      (when (<= start-idx end-idx)
                        (let* ((c1-val (- start-idx sqrt-m))
                               (xc1-val (case c1-val (1 x-val) (2 x2-val) (3 x3-val) (4 x4-val) (5 x5-val) (0 1)))
                               (y-l-start (mod* pow-y-k xc1-val))
                               
                               (m-b-val (mod (- b-val r-idx) 5))
                               (c2-val (- 5 m-b-val))
                               (xc2-val (case c2-val (1 x-val) (2 x2-val) (3 x3-val) (4 x4-val) (5 x5-val) (0 1)))
                               (y-l-end5 (mod* term-m xc2-val))
                               
                               (num-val (mod- y-l-start y-l-end5))
                               (term-val (mod* num-val inv-val)))
                          (if (= c-val 1) 
                              (setf ans-2 (mod+ ans-2 term-val)) 
                              (setf ans-2 (mod- ans-2 term-val)))))))))))
        (mod+ ans-1 ans-2)))))

(defun calc-v (m-val d-sq-val a-base b-base inv-sqrt5)
  (let* ((z-a (mod-pow a-base d-sq-val))
         (z-b (mod-pow b-base d-sq-val))
         (w-a (calc-w m-val z-a))
         (w-b (calc-w m-val z-b)))
    (mod* (mod- w-a w-b) inv-sqrt5)))

(defun solve ()
  (let* ((limit-val $max-d-limit)
         (is-prime (make-array (1+ limit-val) :element-type 'bit :initial-element 1)))
    (setf (aref is-prime 0) 0
          (aref is-prime 1) 0
          (aref *mu* 1) 1)
    (iterate (for idx from 2 to limit-val)
      (when (= 1 (aref is-prime idx))
        (vector-push idx *primes*)
        (setf (aref *mu* idx) -1))
      (iterate (for p-val in-vector *primes*)
        (when (> (* idx p-val) limit-val) (finish))
        (setf (aref is-prime (* idx p-val)) 0)
        (if (zerop (mod idx p-val))
            (progn
              (setf (aref *mu* (* idx p-val)) 0)
              (finish))
            (setf (aref *mu* (* idx p-val)) (- (aref *mu* idx))))))
            
  (let* ((sqrt5-val (tonelli-shanks 5 $p))
         (inv-sqrt5 (mod-pow sqrt5-val (- $p 2)))
         (inv-2 (mod-pow 2 (- $p 2)))
         (a-base (mod* (mod+ 1 sqrt5-val) inv-2))
         (b-base (mod* (mod- 1 sqrt5-val) inv-2))
         (total-sum 0))
    (iterate (for d-idx from 1 to $max-d-limit)
      (let ((mu-val (aref *mu* d-idx)))
        (when (/= mu-val 0)
          (let* ((m-val (floor $n (* d-idx d-idx)))
                 (v-val (calc-v m-val (mod (* d-idx d-idx) (1- $p)) a-base b-base inv-sqrt5)))
            (if (= mu-val 1)
                (setf total-sum (mod+ total-sum v-val))
                (setf total-sum (mod- total-sum v-val)))))))
    (format t "Log: Final Total = ~A~%" total-sum)
    total-sum)))


